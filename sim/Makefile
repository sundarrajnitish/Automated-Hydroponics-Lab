# Builds the simulator two ways from the same sources:
#   make native  -> build/libhydrosim.so   (Python analysis, tests)
#   make wasm    -> build/hydrosim.wasm    (website; needs clang + wasm-ld)
#   make web     -> docs/js/hydrosim-wasm.js (the .wasm, base64-embedded)
SRC = plant.cpp vboard.cpp arduino_mock.cpp unit_firmware.cpp api.cpp \
      ../firmware/Hydroponics/src/hydro_core.cpp
DEPS = $(SRC) $(wildcard *.h arduino_mock/*.h arduino_mock/avr/*.h) \
       ../firmware/Hydroponics/Hydroponics.ino \
       ../firmware/Hydroponics/config.h ../firmware/Hydroponics/src/hydro_core.h
# -ffp-contract=off: no fused multiply-add, so native and wasm agree bit for bit
FLAGS = -O2 -std=c++17 -ffp-contract=off -fno-exceptions -fno-rtti -I. -Iarduino_mock -w
CXX ?= g++

native: build/libhydrosim.so
wasm: build/hydrosim.wasm
web: ../docs/js/hydrosim-wasm.js

build/libhydrosim.so: $(DEPS)
	@mkdir -p build
	$(CXX) $(FLAGS) -fPIC -shared -o $@ $(SRC)

build/hydrosim.wasm: $(DEPS) wasm_rt.cpp
	@mkdir -p build
	clang++ --target=wasm32 -nostdlib -ffreestanding -fvisibility=hidden $(FLAGS) \
	  -Wl,--no-entry -Wl,--export-dynamic -Wl,--export=__wasm_call_ctors -Wl,--strip-all \
	  -Wl,-z,stack-size=262144 -o $@ $(SRC) wasm_rt.cpp

../docs/js/hydrosim-wasm.js: build/hydrosim.wasm
	python3 -c "import base64,sys;d=open('build/hydrosim.wasm','rb').read();open('$@','w').write('// generated by sim/Makefile from the C++ simulator - do not edit\nexport const WASM_BASE64 = \"'+base64.b64encode(d).decode()+'\";\n')"

clean:
	rm -rf build
.PHONY: native wasm web clean
